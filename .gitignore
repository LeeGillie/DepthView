# --- build output ---
bin/
obj/
publish/

# --- IDE ---
.vs/
.idea/
*.user
*.suo
*.userprefs

# --- scratch output from running the tools by hand or in CI ---
# check_fit.py works on tuned copies written beside the repository root; they are outputs,
# not fixtures, and are recreated by the --tune lines in build.yml.
# Anchored with a leading slash, because an unanchored fit-*.png also matches
# docs/images/fit-pad-background.png, which is a tracked README image.
/fit-*.png
/fit-*.svg
_fit/
*-tuned.png
*-rim-mask.png
depthview-calibration*.png
depthview-calibration*-worksheet.txt

# --- runtime state, not source ---
# Written next to the executable when you save an edited material library.
materials.json

# --- generated test data (recreate with the scripts in tests/) ---
tests/fixtures/
tests/textures/
tests/renders/
tests/*.txt
**/*-report.txt

# --- samples: allow-list, not a deny-list ---
# samples/ is where you naturally drop a depth map to try it on, and most depth maps are
# somebody's artwork. Publishing one because `git add -A` swept it up would be a licensing
# problem and a betrayal of whoever made it, so the default here is REFUSE: everything in
# samples/ is ignored unless it is named below. Adding a sample to the repository has to be
# a deliberate act, taken by someone who has checked they have the right to redistribute it.
# Drop anything you like in this folder; git will leave it alone.
samples/*
!samples/README.md
!samples/make_samples.py
!samples/01-genuine-16bit.png
!samples/02-imposter-x257.png
!samples/03-imposter-high-byte.png
!samples/04-quantised-1024.png
!samples/05-grey-stored-as-rgb.png
!samples/06-honest-8bit.png
!samples/07-wasted-headroom.png
!samples/08-colour-contaminated.png

# --- artwork intermediates ---
# The finished banners and hero-keyed.png ARE tracked. Everything below is regenerated by
# make_hero.py and the --render line documented at the top of make_banner.py.
artwork/fonts/
artwork/banner/hero-source.png
artwork/banner/hero-sliced.png
artwork/banner/hero-smooth.png
artwork/banner/hero-steel.png
artwork/banner/h-*.png
artwork/banner/_tmp.html

# --- local check scratch ---
# run-checks.cmd is the local stand-in for the "Tune with every fit policy" job in build.yml,
# and the smoke shot is what proves the 3D panes actually drew. Both are regenerated on
# demand and neither belongs in the history; anchored so nothing under src/ is caught.
/run-checks.cmd
/tune-relief-smoke.png
/shot-steps.cmd
/steps-before.png
/steps-after.png
/rep.txt
/d-*.png
/hdr.png
/depth.png
/p1.png
/p2.png
/proj.txt
/projerr.txt
/help.txt
/try-project.ps1
/wws.txt
/hrmc.txt
/open-*.png
/embedded*.png
/source*.png
/source*.webp

# --- personal drafts and one-off diagnostics ---
# Forum replies and social posts are correspondence, not source. The lb-* and live-lb-*
# scripts hardcode one machine's paths and were written to answer a single question.
/forum-reply-*.md
/wecreat-fb-update.md
/tests/lb-crash.ps1
/tests/lb-state.ps1
/tests/live-lb.ps1
/tests/live-lb2.ps1
/commitmsg.txt 
/tagmsg.txt 
/tag-push.cmd 
/ignoremsg.txt 
