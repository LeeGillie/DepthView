# --- build output ---
bin/
obj/
publish/

# --- IDE ---
.vs/
.idea/
*.user
*.suo
*.userprefs

# --- runtime state, not source ---
# Written next to the executable when you save an edited material library.
materials.json

# --- generated test data (recreate with the scripts in tests/) ---
tests/fixtures/
tests/textures/
tests/renders/
tests/*.txt
**/*-report.txt

# --- artwork intermediates ---
# The finished banners and hero-keyed.png ARE tracked. Everything below is regenerated by
# make_hero.py and the --render line documented at the top of make_banner.py.
artwork/fonts/
artwork/banner/hero-source.png
artwork/banner/hero-sliced.png
artwork/banner/hero-smooth.png
artwork/banner/hero-steel.png
artwork/banner/h-*.png
artwork/banner/_tmp.html
